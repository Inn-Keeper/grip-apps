{
  "name": "grip",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:mobile:client": "pnpm --filter mobile dev-client",
    "dev:mobile:ios": "pnpm --filter mobile ios:sim",
    "dev:mobile:android": "pnpm --filter mobile android",
    "mobile": "pnpm dev:mobile",
    "build": "pnpm --filter web build",
    "build:mobile:ios": "pnpm --filter mobile build:ios:sim",
    "preview": "pnpm --filter web preview",
    "postinstall": "pnpm --filter mobile exec install-skia",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @grip/core typecheck && pnpm --filter mobile exec tsc --noEmit && pnpm --filter web typecheck",
    "test": "pnpm test:eslint-rules && pnpm --filter @grip/core test && pnpm --filter mobile test && pnpm --filter web test",
    "test:eslint-rules": "node --test eslint-rules/*.test.mjs",
    "seed:questions": "node --env-file-if-exists=.env scripts/seed-questions.mjs",
    "clean:ghosts": "find . -name '._*' -not -path '*/.git/*' -delete",
    "ci": "pnpm lint && pnpm test && pnpm typecheck && pnpm build",
    "generate:types": "pnpm --filter @grip/core generate:types && pnpm --filter web generate:types && pnpm --filter mobile generate:types"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "form-data": "4.0.6",
      "js-yaml": "4.3.2",
      "uuid": "11.1.1",
      "shell-quote": "^1.11.0",
      "@xmldom/xmldom@<0.9": "^0.8.15",
      "@xmldom/xmldom@>=0.9 <1": "^0.9.12",
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=2 <3": "^2.1.7",
      "brace-expansion@>=3 <6": "^5.0.12",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "compression": "^1.8.2",
      "nanoid@<4": "^3.3.18",
      "postcss": "^8.5.23",
      "source-map-js": "^1.2.2",
      "decode-uri-component": "^0.5.0"
    }
  }
}
