# Server-side only. Used by scripts (e.g. scripts/seed-questions.mjs), never by
# the apps — the web and mobile clients read their own apps/*/.env files.
#
# Copy to .env (gitignored) and run `pnpm seed:questions`. Variables already set
# in the shell win, so CI can pass them as secrets without a file.

SUPABASE_URL=https://your-project.supabase.co

# Bypasses row-level security. Keep it out of the apps' .env files, out of git
# and out of anything shipped to a client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
