EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Cloudflare Turnstile site key (public). Empty = CAPTCHA off.
# Local/dev: Cloudflare's always-pass test key (pair with the test secret in Supabase).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Hostname the WebView widget reports; must be allowed on the real Turnstile widget.
EXPO_PUBLIC_TURNSTILE_BASE_URL=http://localhost
# grip-ai-api, for grading the talk track. Empty = grading hidden.
# The simulator reaches the Mac at localhost; a phone needs the Mac's LAN address.
EXPO_PUBLIC_AI_URL=http://localhost:8000
