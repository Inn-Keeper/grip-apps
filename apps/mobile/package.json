{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/dom-webview": "~57.0.1",
    "@grip/core": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "expo": "~57.0.32",
    "expo-constants": "~57.0.23",
    "expo-dev-client": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.30",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "clean:ghosts": "find ../.. -name '._*' -not -path '*/.git/*' -delete",
    "preios": "pnpm clean:ghosts",
    "ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios",
    "preios:sim": "pnpm clean:ghosts",
    "ios:sim": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios --device \"iPhone 16 Pro\"",
    "preandroid": "pnpm clean:ghosts",
    "android": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:android",
    "web": "expo start --web",
    "lint": "expo lint",
    "dev-client": "expo start --dev-client",
    "build:ios:dev": "npx eas-cli build --platform ios --profile development",
    "build:android:dev": "npx eas-cli build --platform android --profile development",
    "build:ios:sim": "npx eas-cli build --platform ios --profile simulator",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "private": true
}
